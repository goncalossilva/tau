#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import { existsSync, readFileSync } from "node:fs";
import { homedir } from "node:os";
import path from "node:path";
import { fileURLToPath } from "node:url";

const THINKING_LEVEL = "max";
const SCRIPT_DIR = path.dirname(fileURLToPath(import.meta.url));
const BARE_PI_ARGS = [
  "-p",
  "--no-session",
  "--no-tools",
  "--no-extensions",
  "--no-skills",
  "--no-prompt-templates",
  "--no-themes",
  "--no-context-files",
  "--system-prompt",
  "You are an independent advisor. Use the supplied task and files as your context.",
  "--append-system-prompt",
  "/dev/null",
];

const FAMILY_ORDER = {
  openai: ["anthropic", "google", "openai"],
  anthropic: ["openai", "google", "anthropic"],
  google: ["openai", "anthropic", "google"],
  unknown: ["anthropic", "openai", "google"],
};

const args = parseArgs(process.argv.slice(2));
const cwd = repoRoot();
const settings = readSettings();
const currentModel =
  args.currentModel ?? process.env.ORACLE_CURRENT_MODEL ?? defaultModel(settings);
const currentFamily = modelFamily(currentModel ?? "") ?? "unknown";
const availableModels = listPiModels();
const enabledModels = new Set((settings.enabledModels ?? []).map(normalizeModelSpec));

if (args.listModels) {
  printModelPlan(availableModels, enabledModels, currentModel, currentFamily);
  process.exit(0);
}

const oracleModel = args.model ?? selectOracleModel(availableModels, enabledModels, currentFamily);
if (!oracleModel) {
  die("Could not find a suitable oracle model from `pi --list-models`.");
}

console.error(
  `[oracle] current=${currentModel ?? "unknown"} family=${currentFamily}; oracle=${oracleModel}`,
);

const bundle = run(path.join(SCRIPT_DIR, "oracle-bundle"), args.bundleArgs, {
  cwd,
  encoding: "utf8",
  maxBuffer: 64 * 1024 * 1024,
});

if (bundle.status !== 0) {
  process.stderr.write(bundle.stderr ?? "");
  process.exit(bundle.status ?? 1);
}

const pi = spawnSync(
  "pi",
  [...BARE_PI_ARGS, "--model", oracleModel, "--thinking", THINKING_LEVEL],
  {
    cwd,
    input: bundle.stdout,
    stdio: ["pipe", "inherit", "inherit"],
  },
);

if (pi.error) die(pi.error.message);
process.exit(pi.status ?? 1);

function parseArgs(argv) {
  const bundleArgs = [];
  let currentModel;
  let model;
  let listModels = false;

  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === "--current" || arg === "--current-model") {
      currentModel = requireValue(argv, (index += 1), arg);
    } else if (arg === "--model" || arg === "--oracle-model") {
      model = normalizeModelSpec(requireValue(argv, (index += 1), arg));
    } else if (arg === "--list-models") {
      listModels = true;
    } else {
      bundleArgs.push(arg);
    }
  }

  return {
    bundleArgs,
    currentModel: currentModel ? normalizeModelSpec(currentModel) : undefined,
    model,
    listModels,
  };
}

function requireValue(argv, index, flag) {
  const value = argv[index];
  if (!value) die(`${flag} requires a value`);
  return value;
}

function readSettings() {
  const settingsPath = path.join(getAgentDir(), "settings.json");
  if (!existsSync(settingsPath)) return {};

  try {
    return JSON.parse(readFileSync(settingsPath, "utf8"));
  } catch (error) {
    console.error(`[oracle] warning: failed to parse ${settingsPath}: ${error.message}`);
    return {};
  }
}

function getAgentDir() {
  const configured = process.env.PI_CODING_AGENT_DIR;
  if (!configured) return path.join(homedir(), ".pi", "agent");
  if (configured === "~") return homedir();
  if (configured.startsWith("~/")) return path.join(homedir(), configured.slice(2));
  return path.resolve(cwd, configured);
}

function defaultModel(settings) {
  if (!settings.defaultProvider || !settings.defaultModel) return undefined;
  return normalizeModelSpec(`${settings.defaultProvider}/${settings.defaultModel}`);
}

function listPiModels() {
  const result = run("pi", [...BARE_PI_ARGS, "--list-models"], {
    cwd,
    encoding: "utf8",
    maxBuffer: 16 * 1024 * 1024,
  });
  if (result.error) die(result.error.message);
  if (result.status !== 0) die(result.stderr || "pi --list-models failed");

  const models = [];
  const output = `${result.stdout ?? ""}\n${result.stderr ?? ""}`;
  for (const line of output.split("\n")) {
    const match = line.match(/^(\S+)\s+(\S+)\s+/);
    if (!match || match[1] === "provider") continue;
    models.push({ provider: match[1], model: match[2], spec: `${match[1]}/${match[2]}` });
  }
  return models;
}

function selectOracleModel(models, enabledModels, currentFamily) {
  for (const family of FAMILY_ORDER[currentFamily] ?? FAMILY_ORDER.unknown) {
    const best = bestModelForFamily(models, enabledModels, family);
    if (best) return best.spec;
  }
  return undefined;
}

function bestModelForFamily(models, enabledModels, family) {
  return models
    .filter((model) => modelFamily(model.spec) === family && modelRank(model.model, family))
    .sort((left, right) => compareModels(left, right, enabledModels, family))[0];
}

function compareModels(left, right, enabledModels, family) {
  return (
    Number(enabledModels.has(normalizeModelSpec(right.spec))) -
      Number(enabledModels.has(normalizeModelSpec(left.spec))) ||
    compareModelRanks(modelRank(right.model, family), modelRank(left.model, family)) ||
    providerRank(right.provider, family) - providerRank(left.provider, family) ||
    left.spec.localeCompare(right.spec)
  );
}

function providerRank(provider, family) {
  const normalized = provider.toLowerCase();
  if (family === "openai") {
    if (normalized === "openai-codex") return 5;
    if (normalized === "openai") return 4;
    if (normalized === "github-copilot") return 3;
    if (normalized.includes("azure")) return 2;
    if (normalized === "openrouter") return 1;
    return 0;
  }

  if (family === "anthropic") {
    if (normalized === "github-copilot") return 4;
    if (normalized === "anthropic") return 3;
    if (normalized === "amazon-bedrock") return 2;
    if (normalized === "openrouter") return 1;
    return 0;
  }

  if (family === "google") {
    if (normalized === "google") return 4;
    if (normalized === "github-copilot") return 3;
    if (normalized.includes("vertex")) return 2;
    if (normalized === "openrouter") return 1;
    return 0;
  }

  return 0;
}

function compareModelRanks(left, right) {
  for (let index = 0; index < Math.max(left.length, right.length); index += 1) {
    const difference = (left[index] ?? 0) - (right[index] ?? 0);
    if (difference) return difference;
  }
  return 0;
}

/** Capability tier comes before numeric release version; unknown series need an explicit override. */
function modelRank(model, family) {
  const normalized = model
    .toLowerCase()
    .replace(/[-_.:]batch$/, "")
    .replace(/[-_.]fast$/, "")
    .replace(/[-_.]v\d+(?::\d+)?$/, "")
    .replace(/[-_.]\d{8}$/, "");

  if (family === "openai") {
    const named = normalized.match(
      /(?:^|[/.])gpt[-_.](\d+)(?:[-_.](\d+))?[-_.](astra|sol|luna)(?:[-_.]pro)?$/,
    );
    if (named) {
      const tier = { astra: 4, sol: 3, luna: 2 }[named[3]];
      return [tier, Number(named[1]), Number(named[2] ?? 0)];
    }
    const legacy = normalized.match(
      /(?:^|[/.])gpt[-_.](4\.1|5(?:\.\d+)?)(?:[-_.](codex(?:[-_.]max)?|pro|thinking))?$/,
    );
    if (legacy) {
      const [major, minor = 0] = legacy[1].split(".").map(Number);
      return [1, major, minor, legacy[2]?.startsWith("codex") ? 1 : 0];
    }
  }

  if (family === "anthropic") {
    const match = normalized.match(
      /(?:^|[/.])claude[-_.](fable|opus|sonnet|haiku)[-_.](\d+)(?:[-_.](\d+))?$/,
    );
    if (match) {
      const tier = { fable: 4, opus: 3, sonnet: 2, haiku: 1 }[match[1]];
      return [tier, Number(match[2]), Number(match[3] ?? 0)];
    }
  }

  if (family === "google") {
    const match = normalized.match(
      /(?:^|[/.])gemini[-_.](\d+)(?:[-_.](\d+))?[-_.](carbon|neon|argon|pro)(?:[-_.]preview(?:[-_.]customtools)?)?$/,
    );
    if (match) {
      const tier = { carbon: 4, neon: 3, argon: 2, pro: 1 }[match[3]];
      return [tier, Number(match[1]), Number(match[2] ?? 0)];
    }
  }

  return undefined;
}

function modelFamily(spec) {
  const normalized = normalizeModelSpec(spec).toLowerCase();
  if (!normalized) return undefined;
  if (/(anthropic|claude)/.test(normalized)) return "anthropic";
  if (/(google|gemini)/.test(normalized)) return "google";
  if (/(openai|gpt|codex)/.test(normalized)) return "openai";
  return undefined;
}

function normalizeModelSpec(spec) {
  return String(spec)
    .trim()
    .replace(/:(off|minimal|low|medium|high|xhigh|max)$/i, "");
}

function printModelPlan(models, enabledModels, currentModel, currentFamily) {
  console.log(`Current model: ${currentModel ?? "unknown"}`);
  console.log(`Current family: ${currentFamily}`);
  console.log(
    `Family order: ${(FAMILY_ORDER[currentFamily] ?? FAMILY_ORDER.unknown).join(" -> ")}`,
  );
  console.log("");

  for (const family of ["anthropic", "openai", "google"]) {
    const best = bestModelForFamily(models, enabledModels, family);
    console.log(`${family}: ${best?.spec ?? "not found"}`);
  }
}

function repoRoot() {
  const result = run("git", ["rev-parse", "--show-toplevel"], { encoding: "utf8" });
  return result.status === 0 ? result.stdout.trim() : process.cwd();
}

function run(command, args, options = {}) {
  return spawnSync(command, args, { ...options });
}

function die(message) {
  console.error(`oracle: ${message}`);
  process.exit(1);
}
